---
import ShowCard from './ShowCard.astro';
import type { Show } from '../lib/types';

interface Props {
  upcoming?: Show[];
  past?: Show[];
}
const { upcoming = [], past = [] } = Astro.props;
const shows = [...upcoming, ...past];
---

{
  shows.length === 0 ? (
    <p class="showlist-empty">No shows announced right now — check back soon.</p>
  ) : (
    <div class="showlist-wrapper">
      <ul>
        {shows.map((show) => <ShowCard show={show} />)}
      </ul>
    </div>
  )
}

<style>
  /* No box — just a wide column with a top rule; each row draws its own
     bottom divider (see ShowCard), so entries read as a plain list. */
  .showlist-wrapper {
    border-top: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .showlist-wrapper ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .showlist-empty {
    text-align: center;
    color: var(--muted);
  }
</style>
