---
import type { Show } from '../lib/types';

interface Props {
  show: Show;
}
const { show } = Astro.props;

const dt = show.date ? new Date(show.date) : null;
// Always render in the venue's local time (Central) regardless of where the
// site is built/served — without an explicit timeZone this used the build
// server's clock (UTC on Cloudflare Pages), which showed the wrong day/hour.
const tz = 'America/Chicago';
const dateStr = dt
  ? `${dt.toLocaleDateString('en-US', { month: 'short', timeZone: tz })}. ${dt.toLocaleDateString('en-US', { day: 'numeric', timeZone: tz })}, ${dt.toLocaleDateString('en-US', { year: 'numeric', timeZone: tz })}`
  : 'Date TBD';
const where = [show.city, show.state].filter(Boolean).join(', ');
const ticketsLabel = show.ticketsLabel || 'Get Tickets';
---

<li class="show">
  <div class="show-datewhere">
    <span class="show-date">{dateStr}</span>
    <span class="show-location">{where}</span>
  </div>
  <div class="show-title">{show.title}</div>
  <div class="show-tickets-link">
    {
      show.soldOut ? (
        <span class="show-soldout">Sold Out</span>
      ) : (
        show.ticketsUrl && (
          <a class="tickets-button" href={show.ticketsUrl}>
            {ticketsLabel}
          </a>
        )
      )
    }
  </div>
</li>

<style>
  .show {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(150px, auto) 1fr auto;
    align-items: center;
    gap: 2rem;
    padding: 1.5rem 0;
    text-align: left;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .show:last-child {
    border-bottom: none;
  }
  .show-datewhere {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .show-date {
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.9rem;
  }
  .show-location {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.8rem;
  }
  .show-title {
    color: var(--accent);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.3;
  }
  /* outline tickets button (plugin .tickets-button) */
  .tickets-button {
    display: inline-block;
    color: var(--accent);
    text-transform: uppercase;
    padding: 8px 16px;
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 2px;
    background: transparent;
    border: 1px solid var(--accent);
    white-space: nowrap;
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  .tickets-button:hover {
    background: var(--accent);
    color: var(--accent-ink);
    text-decoration: none;
  }
  .show-soldout {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .show {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      text-align: center;
    }
  }
</style>
