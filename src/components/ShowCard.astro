---
import type { Show } from '../lib/types';

interface Props {
  show: Show;
}
const { show } = Astro.props;

const dt = show.date ? new Date(show.date) : null;
// Always render in the venue's local time (Central) regardless of where the
// site is built/served — without an explicit timeZone this used the build
// server's clock (UTC on Cloudflare Pages), which showed the wrong day/hour.
const dateStr = dt
  ? dt.toLocaleDateString('en-US', {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'America/Chicago',
    })
  : 'Date TBD';
const timeStr = dt
  ? dt.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' })
  : '';
const where = [show.city, show.state].filter(Boolean).join(', ');
const ticketsLabel = show.ticketsLabel || 'Get Tickets';
---

<li class="show">
  <div class="show-info">
    <span class="show-title">{show.title}</span>
    <span class="show-when">{dateStr}{timeStr ? ` · ${timeStr}` : ''}</span>
  </div>
  <div class="show-location">{where}</div>
  <div class="show-tickets-link">
    {
      show.soldOut ? (
        <span class="show-soldout">Sold Out</span>
      ) : (
        show.ticketsUrl && (
          <a class="tickets-button" href={show.ticketsUrl} target="_blank" rel="noopener">
            {ticketsLabel}
          </a>
        )
      )
    }
  </div>
</li>

<style>
  .show {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;
    text-align: left;
  }
  .show:not(:last-child) {
    border-bottom: 1px dashed var(--accent);
  }
  .show-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .show-title {
    font-weight: 700;
    font-size: 1.1em;
    color: var(--accent);
  }
  .show-when {
    color: var(--accent);
    opacity: 0.75;
    font-size: 0.85em;
  }
  .show-location {
    color: var(--accent);
    white-space: nowrap;
  }
  /* outline tickets button (plugin .tickets-button) */
  .tickets-button {
    display: inline-block;
    color: var(--accent);
    text-transform: uppercase;
    padding: 8px 16px;
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 2px;
    background: transparent;
    border: 1px solid var(--accent);
    white-space: nowrap;
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  .tickets-button:hover {
    background: var(--accent);
    color: var(--accent-ink);
    text-decoration: none;
  }
  .show-soldout {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .show {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      text-align: center;
    }
    .show-location {
      white-space: normal;
    }
  }
</style>
