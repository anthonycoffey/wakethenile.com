---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShowList from '../components/ShowList.astro';
import { sanityFetch } from '../lib/sanity';
import { upcomingShowsQuery, pastShowsQuery, showsPageQuery } from '../lib/queries';
import { urlFor } from '../lib/sanityImage';
import type { Show, Page } from '../lib/types';

const [upcoming, past, config] = await Promise.all([
  sanityFetch<Show[]>(upcomingShowsQuery, {}, []),
  sanityFetch<Show[]>(pastShowsQuery, {}, []),
  sanityFetch<Page | null>(showsPageQuery, {}, null),
]);

const bg = config?.coverImage ? urlFor(config.coverImage) : undefined;
const ov = config?.overlay;
const overlayOn = ov?.enabled !== false && !!ov?.color;
const overlayColor = ov?.color ?? '#212121';
const overlayOpacity = typeof ov?.opacity === 'number' ? ov.opacity : 0.5;
---

<BaseLayout title="Shows" description="Tour dates and live shows." footer="scroll">
  <!-- Fixed-height hero (not a full-page fixed backdrop) so the list below
       sits in plain black instead of overlaid on the photo. -->
  <section class="shows-hero" style={bg ? `--cover-bg: url('${bg}')` : undefined}>
    {bg && <div class="shows-hero__bg" />}
    {bg && overlayOn && (
      <div class="shows-hero__overlay" style={`background:${overlayColor}; opacity:${overlayOpacity}`} />
    )}
    <h1 class="shows-hero__title">Shows</h1>
  </section>
  <section class="shows-list">
    <ShowList upcoming={upcoming} past={past} />
  </section>
</BaseLayout>

<style>
  .shows-hero {
    position: relative;
    min-height: 65vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .shows-hero__bg {
    position: absolute;
    inset: 0;
    background-image: var(--cover-bg);
    background-size: cover;
    background-position: center;
    z-index: -2;
  }
  .shows-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .shows-hero__title {
    position: relative;
    z-index: 1;
    text-align: center;
    color: var(--accent);
    font-size: clamp(3.5rem, 3rem + 4vw, 5.5rem);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .shows-list {
    background: var(--bg);
    padding: 2.5rem 1.25rem 5rem;
  }
  @media (max-width: 640px) {
    .shows-hero {
      min-height: 45vh;
    }
  }
</style>
