---
// wakethenile.com/albumrelease
// The single presale landing page for our first live show (Sept 19 @ Dwell
// Coworking Manchaca Auditorium). Three tiers: VIP Fan Experience ($100,
// ticket + free drinks + Ultimate Fan Merch Bundle, tee/size picker), GA+
// ($60, ticket + free drinks all night), and GA ($30, ticket only).
// /releaseparty used to sell the VIP bundle (and a separate $20 "Early Bird"
// GA ticket, now retired) as its own funnel — it now 301s here
// (public/_redirects) so every entry point on the site converges on one page
// and one price ladder. See docs/specs/active/albumrelease-consolidate-releaseparty.md
// and docs/specs/active/albumrelease-ga-tiers.md.
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityFetch } from '../lib/sanity';
import { urlForWidth } from '../lib/sanityImage';
import { bundleOptionGroupsFor } from '../lib/bundleOptions';

interface PresaleProduct {
  id: string;
  images?: unknown[];
  price?: number;
}

// Product IDs + cart line data. These match the products created in Sanity;
// if you ever recreate these products, update the IDs here (and the sync
// checklist in the specs above) to match.
const VIP_PRODUCT_ID = 'b351d11f-4c78-4a1f-b36b-c10d951c96ea';
const GA_PLUS_PRODUCT_ID = 'albumrelease-ga-plus';
const GA_PRODUCT_ID = 'albumrelease-ga';

const query = `*[_type == "product" && _id in [$vipId, $gaPlusId, $gaId]]{
  "id": _id, images, price
}`;
const products = await sanityFetch<PresaleProduct[]>(
  query,
  { vipId: VIP_PRODUCT_ID, gaPlusId: GA_PLUS_PRODUCT_ID, gaId: GA_PRODUCT_ID },
  [],
);
const vip = products.find((p) => p.id === VIP_PRODUCT_ID);
const gaPlus = products.find((p) => p.id === GA_PLUS_PRODUCT_ID);
const ga = products.find((p) => p.id === GA_PRODUCT_ID);

// Prices always come from Sanity (same source checkout re-validates against)
// rather than being hardcoded here, so a price change in the CMS doesn't
// silently drift from what this page displays.
const vipPrice = vip?.price ?? 0;
const gaPlusPrice = gaPlus?.price ?? 0;
const gaPrice = ga?.price ?? 0;

// VIP reuses the same "interlocked" poster-behind / bundle-photo-in-front
// stack /releaseparty used — the show poster is GA's image, shared across
// tiers (see the spec: "Both reuse the existing show poster image asset").
const posterImg = urlForWidth(ga?.images?.[0], 900);
const vipImg = urlForWidth(vip?.images?.[0], 900);
const gaPlusImg = urlForWidth(gaPlus?.images?.[0], 900);
const gaImg = posterImg;

// Tee/size the customer must pick with the VIP bundle (shared with /merch +
// the checkout validator). See ADR 0007 / src/lib/bundleOptions.ts.
const vipOptionGroups = bundleOptionGroupsFor(VIP_PRODUCT_ID) ?? [];
---

<BaseLayout
  title="Album Release Presale"
  description="Get tickets to our first live show — September 19th at Dwell Coworking Manchaca Auditorium."
  footer="scroll"
>
  <section class="albumrelease">
    <p class="albumrelease__eyebrow">Our First Live Show</p>
    <h1 class="albumrelease__title">
      <span class="albumrelease__title-date">September 19</span>
      <span class="albumrelease__title-venue">@ Dwell Coworking Manchaca Auditorium</span>
    </h1>
    <p class="albumrelease__sub">
      Pick your tier below. GA is General Admission entry — GA+ throws in
      <span class="albumrelease__highlight">🍹 free drinks, all night long</span> — or go all-in with the
      VIP Fan Experience for free drinks plus the Ultimate Fan Merch Bundle.
    </p>
    <p class="albumrelease__note">Tickets are collected at the door on show night; any merch can be picked up at our Merch booth — nothing ships.</p>

    <div class="albumrelease__cards">
      <button type="button" class="albumrelease__card" data-product="ga" data-price={gaPrice}>
        <span class="albumrelease__imgstack">
          {gaImg && <img src={gaImg} alt="Album Release Show Poster" class="albumrelease__img" />}
        </span>
        <h2 class="albumrelease__name">GA</h2>
        <p class="albumrelease__price">${gaPrice}</p>
        <p class="albumrelease__desc">General Admission — Live Show Ticket</p>
        <span class="albumrelease__cta">Add to Cart →</span>
      </button>

      <button type="button" class="albumrelease__card" data-product="ga-plus" data-price={gaPlusPrice}>
        <span class="albumrelease__imgstack">
          {gaPlusImg && <img src={gaPlusImg} alt="Album Release Show Poster" class="albumrelease__img" />}
        </span>
        <h2 class="albumrelease__name">GA+</h2>
        <p class="albumrelease__price">${gaPlusPrice}</p>
        <p class="albumrelease__perk">🍹 Free Drinks All Night</p>
        <p class="albumrelease__desc">Includes the Live Show Ticket</p>
        <span class="albumrelease__cta">Add to Cart →</span>
      </button>

      <div class="albumrelease__card albumrelease__card--bundle">
        <span class="albumrelease__imgstack albumrelease__imgstack--double">
          {posterImg && <img src={posterImg} alt="Album Release Show Poster" class="albumrelease__img albumrelease__img--back" />}
          {vipImg && <img src={vipImg} alt="Ultimate Fan Merch Bundle" class="albumrelease__img albumrelease__img--front" />}
        </span>
        <h2 class="albumrelease__name">VIP Fan Experience</h2>
        <p class="albumrelease__price">${vipPrice}</p>
        <p class="albumrelease__perk">🍹 Free Drinks + Merch Bundle</p>
        <p class="albumrelease__desc">VIP Show ticket (unlimited free drinks) + Ultimate Fan Merch Bundle</p>

        <div class="albumrelease__options">
          {vipOptionGroups.map((group) => (
            <div class="albumrelease__optgroup" data-group={group.name}>
              <span class="albumrelease__optlabel">{group.name}</span>
              <div class="albumrelease__opts">
                {group.values.map((value) => (
                  <button type="button" class="albumrelease__opt" data-value={value} aria-pressed="false">
                    {value}
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>

        <button type="button" class="albumrelease__cta albumrelease__cta--btn" data-vip-add data-price={vipPrice} disabled>
          Select tees &amp; sizes
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { addItem } from '../lib/cart';

  const VIP_PRODUCT_ID = 'b351d11f-4c78-4a1f-b36b-c10d951c96ea';
  const GA_PLUS_PRODUCT_ID = 'albumrelease-ga-plus';
  const GA_PRODUCT_ID = 'albumrelease-ga';

  const cardImage = (root: Element): string | undefined => {
    const imgs = root.querySelectorAll('img');
    return imgs[imgs.length - 1]?.getAttribute('src') ?? undefined;
  };

  // GA+ — no options to pick (no merch), so it goes straight to checkout,
  // same as the original bundle's frictionless path.
  const gaPlusCard = document.querySelector<HTMLButtonElement>('[data-product="ga-plus"]');
  gaPlusCard?.addEventListener('click', () => {
    addItem({
      productId: GA_PLUS_PRODUCT_ID,
      slug: 'ga-plus-album-release',
      title: 'GA+',
      sku: 'GA-PLUS',
      unitPrice: Number(gaPlusCard.dataset.price) || 0,
      qty: 1,
      image: cardImage(gaPlusCard),
    });
    window.location.href = '/checkout';
  });

  // GA — plain ticket, nudges to merch before checkout.
  const gaCard = document.querySelector<HTMLButtonElement>('[data-product="ga"]');
  gaCard?.addEventListener('click', () => {
    addItem({
      productId: GA_PRODUCT_ID,
      slug: 'ga-album-release',
      title: 'GA',
      sku: 'GA',
      qty: 1,
      unitPrice: Number(gaCard.dataset.price) || 0,
      image: cardImage(gaCard),
    });
    sessionStorage.setItem('wtn_upsell_msg', '1');
    sessionStorage.setItem('wtn_promo', 'WTN15OFF');
    window.location.href = '/merch';
  });

  // VIP bundle — the tee + size must be chosen before the CTA unlocks.
  const vipCard = document.querySelector<HTMLElement>('.albumrelease__card--bundle');
  if (vipCard) {
    const addBtn = vipCard.querySelector<HTMLButtonElement>('[data-vip-add]');
    const groups = [...vipCard.querySelectorAll<HTMLElement>('.albumrelease__optgroup')];
    const choices: Record<string, string> = {};

    const groupName = (g: HTMLElement) => g.dataset.group ?? '';
    const allChosen = () => groups.every((g) => choices[groupName(g)]);

    const refresh = () => {
      if (!addBtn) return;
      const ready = allChosen();
      addBtn.disabled = !ready;
      addBtn.textContent = ready ? 'Add to Cart →' : 'Select your tees & sizes';
    };

    for (const g of groups) {
      const name = groupName(g);
      const opts = [...g.querySelectorAll<HTMLButtonElement>('.albumrelease__opt')];
      for (const btn of opts) {
        btn.addEventListener('click', () => {
          choices[name] = btn.dataset.value ?? '';
          for (const b of opts) b.setAttribute('aria-pressed', String(b === btn));
          refresh();
        });
      }
    }

    addBtn?.addEventListener('click', () => {
      if (!allChosen()) return;
      const options = groups.map((g) => ({ name: groupName(g), value: choices[groupName(g)] }));
      addItem({
        productId: VIP_PRODUCT_ID,
        slug: 'superfans',
        title: 'VIP Fan Experience',
        sku: 'superfans',
        unitPrice: Number(addBtn.dataset.price) || 0,
        qty: 1,
        image: cardImage(vipCard),
        options,
      });
      // VIP buyers skip merch browsing entirely — straight to checkout.
      window.location.href = '/checkout';
    });
  }
</script>

<style>
  .albumrelease {
    max-width: 1300px;
    margin-inline: auto;
    padding: calc(8vh + 4.5rem) 1.5rem 2rem;
    text-align: center;
  }
  .albumrelease__eyebrow {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.8rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .albumrelease__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    margin: 0 0 0.75rem;
  }
  .albumrelease__title-date {
    color: var(--accent);
    font-size: clamp(2rem, 1.6rem + 3vw, 3.5rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .albumrelease__title-venue {
    color: var(--accent);
    font-size: clamp(1rem, 0.85rem + 1vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
    opacity: 0.9;
  }
  .albumrelease__sub {
    color: var(--muted);
    max-width: 52ch;
    margin: 0 auto 0.75rem;
    font-size: 0.95rem;
  }
  .albumrelease__note {
    color: var(--accent);
    opacity: 0.85;
    max-width: 50ch;
    margin: 0 auto 3.5rem;
    font-size: 0.82rem;
  }
  .albumrelease__highlight {
    display: inline-block;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--accent);
    font-weight: 800;
    padding: 0.05em 0.5em;
    border-radius: 6px;
  }

  /* Cards float below the main content and slightly overlap the footer. */
  .albumrelease__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: -70px;
    position: relative;
    z-index: 2;
  }
  @media (max-width: 900px) {
    .albumrelease__cards {
      grid-template-columns: 1fr;
      margin-bottom: -40px;
    }
  }

  .albumrelease__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #0d0d0d;
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: var(--radius);
    padding: 2rem 1.5rem 2.25rem;
    cursor: pointer;
    font-family: inherit;
    color: var(--accent);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .albumrelease__card:hover,
  .albumrelease__card:focus-visible {
    transform: translateY(-10px) scale(1.03);
    border-color: var(--accent);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.55);
    outline: none;
  }

  /* The VIP bundle card is a container (not a single click target) — its own
     controls handle clicks, so don't imply the whole card is clickable. */
  .albumrelease__card--bundle {
    cursor: default;
  }

  .albumrelease__imgstack {
    display: block;
    position: relative;
    width: 100%;
    max-width: 320px;
    /* Matches the poster art's real 1728x2304 (3:4) proportions. */
    aspect-ratio: 3 / 4;
    margin-bottom: 1.5rem;
  }
  .albumrelease__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--radius) - 2px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
  }
  /* VIP card: show poster behind (top-left), merch bundle in front
     (bottom-right) — same "interlocked" stack /releaseparty used. */
  .albumrelease__imgstack--double .albumrelease__img {
    position: absolute;
    width: 60%;
    height: 60%;
  }
  .albumrelease__img--back {
    top: 0;
    left: 0;
  }
  .albumrelease__img--front {
    bottom: 0;
    right: 0;
    border: 3px solid var(--bg);
  }

  .albumrelease__name {
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 0.4rem;
  }
  .albumrelease__price {
    font-size: 1.75rem;
    font-weight: 800;
    margin: 0 0 0.6rem;
  }
  .albumrelease__perk {
    color: var(--accent-ink);
    background: var(--accent);
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 0.35em 0.9em;
    border-radius: 100px;
    margin: 0 0 0.75rem;
  }
  .albumrelease__desc {
    color: var(--muted);
    font-size: 0.85rem;
    max-width: 30ch;
    margin: 0 0 1.5rem;
  }
  .albumrelease__cta {
    display: inline-block;
    border: 2px solid var(--accent);
    color: var(--accent);
    border-radius: 100px;
    text-transform: uppercase;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 1px;
    padding: 0.6em 1.4em;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  /* Only the plain (GA/GA+) cards fill their CTA on hover. The VIP CTA is a
     real button with its own hover/disabled states below. */
  .albumrelease__card:not(.albumrelease__card--bundle):hover .albumrelease__cta {
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* VIP tee/size selectors. */
  .albumrelease__options {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
    text-align: left;
  }
  .albumrelease__optlabel {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .albumrelease__opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .albumrelease__opt {
    min-width: 2.8rem;
    padding: 0.5rem 0.85rem;
    background: transparent;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .albumrelease__opt:hover {
    border-color: var(--accent);
  }
  .albumrelease__opt[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  /* CTA rendered as a <button> on the VIP card. */
  .albumrelease__cta--btn {
    background: transparent;
    font-family: inherit;
    cursor: pointer;
  }
  .albumrelease__cta--btn:not(:disabled):hover {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .albumrelease__cta--btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
