---
// wakethenile.com/music — the Obuntu album: hero banner is the album art,
// followed by the full 9-song track list (album order) with inline players.
// Audio/cover assets are static files, not CMS-managed, matching how /videos
// coverflow entries and /drifting already host their media. See
// docs/specs/active/post-show-site-reset.md.
import BaseLayout from '../layouts/BaseLayout.astro';

const albumCover = '/images/obuntu-cover.jpg';
const albumThumb = '/images/obuntu-cover-thumb.jpg';

interface Track {
  title: string;
  audio: string;
}

// Album order (matches the sequenced album files, 01–09).
const tracks: Track[] = [
  { title: 'Lamb', audio: '/audio/lamb.mp3' },
  { title: 'Fall', audio: '/audio/fall.mp3' },
  { title: 'Mercy', audio: '/audio/mercy.mp3' },
  { title: 'Dance', audio: '/audio/dance.mp3' },
  { title: 'Drifting Away', audio: '/audio/drifting-away.mp3' },
  { title: 'Elements', audio: '/audio/elements.mp3' },
  { title: 'Walk (Run)', audio: '/audio/walk-run.mp3' },
  { title: 'Champion', audio: '/audio/champion.mp3' },
  { title: 'Matter', audio: '/audio/matter.mp3' },
];
---

<BaseLayout title="Music" description="Listen to music from Wake the Nile." footer="scroll">
  <section class="music">
    <div class="music__hero">
      <img class="music__hero-img" src={albumCover} alt="Obuntu — album cover art" width="1600" height="1600" fetchpriority="high" />
      <div class="music__hero-fade" />
    </div>
    <div class="music__content">
      <ol class="tracklist">
        {tracks.map((track, i) => (
          <li class="track">
            <img class="track__cover" src={albumThumb} alt="" width="120" height="120" loading="lazy" />
            <div class="track__body">
              <p class="track__title"><span class="track__num">{String(i + 1).padStart(2, '0')}</span>{track.title}</p>
              <audio class="track__audio" controls preload="none" src={track.audio}>
                Your browser doesn't support inline audio.
              </audio>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .music {
    position: relative;
    padding-bottom: 4rem;
  }
  /* The art's edge is a flat #d4101a, so the square cover centred on that
     field reads as a full-bleed banner without cropping the wordmark. */
  .music__hero {
    position: relative;
    z-index: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    background: #d4101a;
    overflow: hidden;
    /* Extra red under the art carries the fade so it never covers the wordmark. */
    padding-bottom: 5rem;
  }
  .music__hero-img {
    display: block;
    width: min(100%, 78vh, 900px);
    height: auto;
    aspect-ratio: 1 / 1;
  }
  .music__hero-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 5rem;
    background: linear-gradient(to bottom, transparent, var(--bg));
    z-index: 2;
  }
  .music__content {
    position: relative;
    max-width: 720px;
    margin-inline: auto;
    margin-top: -2.5rem;
    padding: 2.5rem 1.25rem 2rem;
    text-align: center;
  }

  .tracklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: left;
  }
  .track {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: rgba(13, 13, 13, 0.75);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: var(--radius);
    padding: 1rem;
    backdrop-filter: blur(4px);
  }
  .track__cover {
    width: 84px;
    height: 84px;
    border-radius: calc(var(--radius) - 2px);
    object-fit: cover;
    flex-shrink: 0;
  }
  .track__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .track__title {
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0;
  }
  .track__num {
    display: inline-block;
    min-width: 1.75em;
    margin-right: 0.5em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .track__audio {
    width: 100%;
    height: 32px;
  }
  @media (max-width: 520px) {
    .track {
      gap: 0.85rem;
      padding: 0.85rem;
    }
    .track__cover {
      width: 64px;
      height: 64px;
    }
  }
</style>
